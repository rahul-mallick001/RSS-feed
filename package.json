{
  "name": "rss-feed",
  "version": "1.0.1",
  "description": "Personal RSS reader with auto-sync, full-text extraction, images and LaTeX rendering",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node scripts/use-abi.js node && node server.js",
    "dev": "node scripts/use-abi.js node && node --watch server.js",
    "desktop": "node scripts/use-abi.js electron && electron .",
    "dist": "node scripts/use-abi.js electron && electron-builder --win"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.2.0",
    "express": "^4.21.2",
    "jsdom": "^26.1.0",
    "katex": "^0.16.22",
    "node-cron": "^4.2.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.rahul.rssfeed",
    "productName": "RSS Reader",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "public/**/*",
      "build/icon.png",
      "server.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/*.node"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RSS Reader",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
